    <Element Type="FunctionDef" Id="D16EE5F6">
        <Identifier>ForEachIntegerinIntegerGroup</Identifier>
        <Label Type="Label" Library="Ntve" Id="E73FD83D"/>
        <FlagAction/>
        <FlagSubFunctions/>
        <FlagAllowBreak/>
        <Parameter Type="ParamDef" Library="Ntve" Id="C40E3712"/>
        <Parameter Type="ParamDef" Library="Ntve" Id="82254C47"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="18B03961"/>
        <ScriptCode>
            #AUTOVAR(g, bitmask) = #PARAM(group);
            #AUTOVAR(p) = 0;
            for ( ; #AUTOVAR(p) &lt;= BitMaskCountOnBits(#AUTOVAR(g)) ; #AUTOVAR(p) += (#PARAM(var) == BitMaskGetNextBit(#AUTOVAR(g), #AUTOVAR(p)))) {
                #PARAM(var) = BitMaskGetNextBit(#AUTOVAR(g), #AUTOVAR(p));
                #SUBFUNCS(Actions)
            }
        </ScriptCode>
    </Element>
    <Element Type="ParamDef" Id="C40E3712">
        <Identifier>var</Identifier>
        <ParameterType>
            <Type Value="anyvariable"/>
            <VariableType Value="int"/>
        </ParameterType>
    </Element>
