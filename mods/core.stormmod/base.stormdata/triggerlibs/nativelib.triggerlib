    <Element Type="FunctionDef" Id="C4DC760C">
        <Identifier>PickEachUnitInGroup</Identifier>
        <Label Type="Label" Library="Ntve" Id="00000013"/>
        <FlagAction/>
        <FlagSubFunctions/>
        <FlagAllowBreak/>
        <Parameter Type="ParamDef" Library="Ntve" Id="F96B466D"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="9441B8B5"/>
        <ScriptCode>
            #AUTOVAR(g, unitgroup) = #PARAM(group);
            #AUTOVAR(u) = UnitGroupCount(#AUTOVAR(g), c_unitCountAll);
            for (;; #AUTOVAR(u) -= 1) {
                #AUTOVAR(var, unit) = UnitGroupUnitFromEnd(#AUTOVAR(g), #AUTOVAR(u));
                if (#AUTOVAR(var) == null) { break; }
                #SUBFUNCS(actions)
            }
        </ScriptCode>
    </Element>
    <Element Type="ParamDef" Id="F96B466D">
        <Identifier>group</Identifier>
        <ParameterType>
            <Type Value="unitgroup"/>
        </ParameterType>
        <Default Type="Param" Library="Ntve" Id="DA9ADFC2"/>
    </Element>
