        <Action/>
    </Element>
    <Element Type="FunctionDef" Id="5AC6E8D8">
        <Identifier>PickEachIntegerinIntegerGroup</Identifier>
        <Label Type="Label" Library="Ntve" Id="E73FD83D"/>
        <FlagAction/>
        <FlagSubFunctions/>
        <FlagAllowBreak/>
        <Parameter Type="ParamDef" Library="Ntve" Id="EF5225EE"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="C8DEF0C2"/>
        <ScriptCode>
            BitMaskLoopBegin(#PARAM(group));
            for ( ; !BitMaskLoopDone() ; BitMaskLoopStep()) {
                #SUBFUNCS(Actions)
            }
            BitMaskLoopEnd();
        </ScriptCode>
    </Element>
