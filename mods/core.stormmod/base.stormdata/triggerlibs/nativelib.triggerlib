    <Element Type="Comment" Id="F518A7A3">
        <Comment>
            Start to partition the array into three pieces:
                      A[i] &lt;= A[lowMedian] for  low --&gt; lowMedian-1
                      A[i] == A[lowMedian] for  lowMedian --&gt; highMedian-1
                      A[i] &gt;= A[lowMedian] for  highMedian --&gt; high
        </Comment>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="4945FAA8"/>
    </Element>
