        <FlagAllowBreak/>
        <Parameter Type="ParamDef" Library="Ntve" Id="42AB3EFD"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="DEA91B62"/>
        <ScriptCode>
            #AUTOVAR(g, playergroup) = #PARAM(group);
            #AUTOVAR(var) = -1;
            while (true) {
            	#AUTOVAR(var) = PlayerGroupNextPlayer(#AUTOVAR(g), #AUTOVAR(var));
            	if (#AUTOVAR(var)&lt;0) { break; }
            	#SUBFUNCS(actions)
            }
        </ScriptCode>
