        <Parameter Type="ParamDef" Library="Ntve" Id="3D933185"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="E239F153"/>
        <ScriptCode>
            while (#PARAM(lock)) {
                Wait(1.0, c_timeGame);
            }
            #PARAM(lock) = true;
            #SUBFUNCS(actions)
            #PARAM(lock) = false;
        </ScriptCode>
    </Element>
