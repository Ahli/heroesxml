        <ScriptCode>
            if (#SUBFUNCS(if,&quot; &amp;&amp; &quot;)) {
                #SUBFUNCS(then)
            }
            #IFHAVESUBFUNCS(else,else {
            )
                #SUBFUNCS(else)
            #IFHAVESUBFUNCS(else,})
        </ScriptCode>
