    <Element Type="FunctionDef" Id="E89F1335">
        <Identifier>WaitForCondition</Identifier>
        <Label Type="Label" Library="Ntve" Id="00000002"/>
        <FlagAction/>
        <FlagSubFunctions/>
        <Parameter Type="ParamDef" Library="Ntve" Id="9C4402E6"/>
        <Parameter Type="ParamDef" Library="Ntve" Id="353DD7DE"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="C1E1D597"/>
        <ScriptCode>
            while (!(#SUBFUNCS(cond,&quot; &amp;&amp; &quot;))) {
                Wait(#PARAM(t), #PARAM(timeType));
            }
        </ScriptCode>
    </Element>
