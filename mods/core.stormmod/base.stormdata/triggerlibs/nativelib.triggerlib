        <Parameter Type="ParamDef" Library="Ntve" Id="6F7CD878"/>
        <FunctionCall Type="FunctionCall" Library="Ntve" Id="CE34796B"/>
        <ScriptCode>
            if (#PARAM(var) &gt;= #PARAM(inMax)) {
                #PARAM(var) = #PARAM(inMin);
