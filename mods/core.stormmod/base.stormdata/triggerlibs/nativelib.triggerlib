    <Element Type="FunctionDef" Id="01DD8AFF">
        <Identifier>WaitForConditionWithMaximumDuration</Identifier>
        <Label Type="Label" Library="Ntve" Id="00000002"/>
        <FlagAction/>
        <FlagSubFunctions/>
        <Parameter Type="ParamDef" Library="Ntve" Id="87841E09"/>
        <Parameter Type="ParamDef" Library="Ntve" Id="8832229B"/>
        <Parameter Type="ParamDef" Library="Ntve" Id="4ECD6D66"/>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="60A877ED"/>
        <ScriptCode>
            #AUTOVAR(at,fixed) = 0;
            while (!(#SUBFUNCS(cond,&quot; &amp;&amp; &quot;)) &amp;&amp; #AUTOVAR(at) &lt;= #PARAM(maxDuration)) {
                Wait(#PARAM(t), #PARAM(timeType));
                #AUTOVAR(at) = #AUTOVAR(at) + #PARAM(t);
            }
        </ScriptCode>
    </Element>
